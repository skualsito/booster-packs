LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=3004
NEXT_PUBLIC_LOCAL_API_URL=https://backend.pullario.juanalmada.com
NEXT_PUBLIC_SITE_URL=https://pullario.juanalmada.com
CORS_ALLOWED_ORIGINS=https://pullario.juanalmada.com

# Session cookie (HttpOnly, Secure, SameSite=Lax). Empty Domain = host-only on
# the API host, which is all the frontend needs. Set .pullario.juanalmada.com
# only if another subdomain must receive it.
SESSION_COOKIE_NAME=pullario_session
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=true

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=pullario
MYSQL_PASSWORD=CAMBIAR_PASSWORD_MYSQL
MYSQL_DATABASE=hitshelf

ADMIN_USERNAME=CAMBIAR_ADMIN
ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN
